# Copy to .env (git-ignored) and fill in. Never commit the real file.
# Only the three keys below are read from this file; anything else is ignored.
ANTHROPIC_API_KEY=
# Optional: override the extraction model (default: claude-haiku-4-5-20251001)
ENRICH_MODEL=
# Set to 1 to use saved LLM fixtures instead of calling the API
MOCK_LLM=0
